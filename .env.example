# Where the database and uploaded files live
DATA_DIR=./data
# Port the server listens on
PORT=8787
# Public address of the app; https enables Secure cookies
PUBLIC_URL=http://localhost:8787
# Passkeys need this to be a domain on https:// (or localhost). Changing the domain invalidates them.
# Optional: set the login password on first start instead of using the setup screen
# INITIAL_PASSWORD=change-me
