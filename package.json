{
  "name": "projectbench",
  "private": true,
  "version": "2026.11.4",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @projectbench/server --filter @projectbench/web dev",
    "build": "pnpm --filter @projectbench/web build && pnpm --filter @projectbench/server build && pnpm --filter @projectbench/mcp-stdio build",
    "start": "pnpm --filter @projectbench/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @projectbench/core db:generate",
    "prepare": "husky"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
